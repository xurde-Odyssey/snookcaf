{
  "name": "snooker-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:auth-cleanup": "node --env-file-if-exists=.env --import tsx prisma/auth-cleanup.ts",
    "test:e2e:phase3": "playwright test --config playwright.phase3.config.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.90.0",
    "react-hook-form": "^7.66.0",
    "@hookform/resolvers": "^5.2.0",
    "zod": "^4.1.0",
    "recharts": "^3.4.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=24.7.0"
  }
}
